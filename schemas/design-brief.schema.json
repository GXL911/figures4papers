{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GXL911/figures4papers/blob/main/schemas/design-brief.schema.json",
  "title": "Scientific Figure Design Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "research_question",
    "intended_takeaway",
    "figure_role",
    "content_blocks",
    "panel_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "intended_takeaway": {
      "type": "string",
      "minLength": 1
    },
    "figure_role": {
      "type": "string",
      "minLength": 1
    },
    "content_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentBlock"
      }
    },
    "panel_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/panel"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "default": []
    },
    "constraints": {
      "type": "object",
      "properties": {
        "target_venue": {
          "type": "string"
        },
        "target_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "preferred_layout": {
          "type": "string"
        },
        "minimum_font_size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "output_formats": {
          "type": "array",
          "items": {
            "enum": [
              "svg",
              "pdf",
              "png",
              "drawio",
              "pptx"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    },
    "required_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "default": []
    }
  },
  "$defs": {
    "contentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "scientific_role",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scientific_role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_source": {
          "type": "string"
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "claim",
        "visual_form",
        "content_block_ids"
      ],
      "properties": {
        "panel_id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "visual_form": {
          "type": "string",
          "minLength": 1
        },
        "content_block_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_contract": {
          "type": "object"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure_id",
        "reason_for_use"
      ],
      "properties": {
        "figure_id": {
          "type": "string",
          "minLength": 1
        },
        "reason_for_use": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_block_id",
        "target_block_id",
        "relation_type"
      ],
      "properties": {
        "source_block_id": {
          "type": "string",
          "minLength": 1
        },
        "target_block_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "enum": [
            "data_flow",
            "control_flow",
            "skip",
            "attention",
            "feedback",
            "other"
          ]
        },
        "must_be_direct": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
